      font-size: 1em;
      border-radius: 5px;
      border: 1px solid #ccc;
    }

    button {
      background-color: #0a4275;
      color: white;
      border: none;
      cursor: pointer;
      transition: transform 0.3s, background 0.3s;
    }
.reviews-container {
  display: flex;
